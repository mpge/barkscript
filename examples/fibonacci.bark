# Two ways to count Fibonacci numbers.

# Recursive: short, slow, and very good at chasing its own tail.
fetch fib(n)
    if n < 2
        drop it n
    end
    drop it fib(n - 1) + fib(n - 2)
end

# Iterative: what you would actually ship.
fetch fibList(count)
    sit list = [0, 1]
    again while list.length < count
        sit size = list.length
        come here list.push(list[size - 1] + list[size - 2])
    end
    drop it list.slice(0, count)
end

woof "fib(20) is {fib(20)}"
woof "The first 15:", fibList(15).join(", ")
